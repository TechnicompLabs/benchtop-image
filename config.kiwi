<?xml version="1.0" encoding="utf-8"?>
<!-- OBS-ExclusiveArch: x86_64 -->
<image schemaversion="7.6" name="TechniComp-Benchtop" displayname="TechniComp Benchtop Linux">
    <description type="system">
        <author>Paul Martin</author>
        <contact>pmartin@pauldmartin.org</contact>
        <specification>TechniComp Benchtop Linux - immutable Tumbleweed-based desktop (minimal first image)</specification>
    </description>
    <preferences>
        <version>0.1.0</version>
        <packagemanager>zypper</packagemanager>
        <rpm-excludedocs>true</rpm-excludedocs>
        <locale>en_US</locale>
        <type
            image="oem"
            filesystem="btrfs"
            fsmountoptions="compress=zstd:1"
            firmware="uefi"
            bootpartition="false"
            initrd_system="none"
            efipartsize="750"
            bootkernel="custom"
            devicepersistency="by-uuid"
            btrfs_root_is_subvolume="true"
            btrfs_root_is_snapshot="true"
            btrfs_root_is_readonly_snapshot="true"
            btrfs_quota_groups="true"
            rootfs_label="TCBENCHTOP"
        >
            <bootloader name="custom"/>
            <partitions>
                <partition name="ignition" size="1G" mountpoint="/ignition" filesystem="ext4" label="ignition"/>
            </partitions>
            <systemdisk>
                <volume name="home"/>
                <volume name="root"/>
                <volume name="opt"/>
                <volume name="srv"/>
                <volume name="boot/grub2/i386-pc"/>
                <volume name="boot/grub2/x86_64-efi" mountpoint="boot/grub2/x86_64-efi"/>
                <volume name="boot/writable"/>
                <volume name="usr/local"/>
                <volume name="var" copy_on_write="false"/>
            </systemdisk>
        </type>
    </preferences>
    <repository type="rpm-md">
        <source path="obsrepositories:/"/>
    </repository>
    <packages type="image">
        <!-- The whole TC Benchtop package set. Resolving this against
             openSUSE:Factory x86_64 IS the dependency gate. -->
        <package name="patterns-tc-benchtop-base"/>
        <!-- Installer: tik (Aeon Tailored Installation Kit). Encryption and
             disk sizing happen at install time via systemd-repart + tik, not in
             the initrd. VERIFY tik resolves in the build repos before relying on
             this build; if it lives in an Aeon devel project, add that project as
             a repository path. -->
        <package name="tik"/>
        <!-- tik requires the virtual "tik-config"; tik-config-Aeon and
             tik-config-generic both provide it, so OBS refuses to choose
             ("have choice for tik-config needed by tik") and the build
             will not start. Name the provider explicitly. Swap this for
             tik-config-benchtop once that package exists. -->
        <package name="tik-config-generic"/>
        <!-- Tools the vendored tik installer modules use at install time
             (root/usr/lib/tik/modules/): TPM2 detect/enroll, recovery-key QR,
             SecureBoot state, laptop AC-power check. -->
        <package name="tpm2.0-tools"/>
        <package name="qrencode"/>
        <package name="mokutil"/>
        <package name="upower"/>
        <!-- Wi-Fi backend, explicit (NetworkManager-wifi also pulls it) -->
        <package name="wpa_supplicant"/>
        <!-- memtest86+ in the installer USB's boot menu. memtest86+-bls ships
             the sdbootutil boot entry (/usr/lib/sdbootutil/entries.d), which
             disk.sh's `sdbootutil install` puts on the USB's ESP. Installed
             systems mask it (tik post module 13-tcbl-no-memtest, config.sh). -->
        <package name="memtest86+"/>
        <package name="memtest86+-bls"/>
        <!-- Performance services (Source: notes Performance/*). rtkit provides
             rtkit-daemon; systemd-experimental provides systemd-oomd on openSUSE. -->
        <package name="rtkit"/>
        <!-- systemd-oomd is disabled for now; uncomment to pull the experimental
             package (and uncomment systemd-oomd.service in config.sh). -->
        <!-- <package name="systemd-experimental"/> -->
        <!-- Wi-Fi stays on wpa_supplicant (NetworkManager's default backend).
             Nothing in patterns-tc-benchtop-base requires iwd; this lock keeps
             it from arriving as a recommended package. KIWI implements <ignore>
             as "zypper al", so the lock persists in the built image. -->
        <ignore name="iwd"/>
    </packages>
    <packages type="bootstrap">
        <package name="coreutils"/>
        <package name="gawk"/>
        <package name="gzip"/>
        <package name="hostname"/>
        <package name="openssl"/>
        <package name="filesystem"/>
        <package name="glibc-locale-base"/>
        <package name="ca-certificates-mozilla"/>
    </packages>
</image>
