<?xml version="1.0" encoding="utf-8"?>
<!-- OBS-ExclusiveArch: x86_64 -->
<image schemaversion="7.6" name="Technicomp-Benchtop" displayname="Technicomp Benchtop Linux">
    <description type="system">
        <author>Paul Martin</author>
        <contact>pmartin@pauldmartin.org</contact>
        <specification>Technicomp Benchtop Linux - immutable Tumbleweed-based desktop (minimal first image)</specification>
    </description>
    <preferences>
        <version>0.1.0</version>
        <packagemanager>zypper</packagemanager>
        <locale>en_US</locale>
        <type
            image="oem"
            filesystem="btrfs"
            fsmountoptions="compress=zstd:1"
            firmware="uefi"
            bootpartition="false"
            initrd_system="none"
            efipartsize="750"
            bootkernel="custom"
            devicepersistency="by-uuid"
            btrfs_root_is_subvolume="true"
            btrfs_root_is_snapshot="true"
            btrfs_root_is_readonly_snapshot="true"
            btrfs_quota_groups="true"
            rootfs_label="TCBENCHTOP"
        >
            <bootloader name="custom"/>
            <partitions>
                <partition name="ignition" size="1G" mountpoint="/ignition" filesystem="ext4" label="ignition"/>
            </partitions>
            <systemdisk>
                <volume name="home"/>
                <volume name="root"/>
                <volume name="opt"/>
                <volume name="srv"/>
                <volume name="boot/grub2/i386-pc"/>
                <volume name="boot/grub2/x86_64-efi" mountpoint="boot/grub2/x86_64-efi"/>
                <volume name="boot/writable"/>
                <volume name="usr/local"/>
                <volume name="var" copy_on_write="false"/>
            </systemdisk>
        </type>
    </preferences>
    <repository type="rpm-md">
        <source path="obsrepositories:/"/>
    </repository>
    <packages type="image">
        <!-- The whole TC Benchtop package set. Resolving this against
             openSUSE:Factory x86_64 IS the dependency gate. -->
        <package name="patterns-tc-benchtop-base"/>
        <!-- Installer: tik (Aeon Tailored Installation Kit) with TCBL's
             configuration and modules, tik-config-benchtop (repository
             benchtop-installer), which requires tik, the tik modules it uses
             unchanged and the tools they need. Encryption and disk sizing
             happen at install time via systemd-repart + tik, not in the
             initrd. -->
        <package name="tik-config-benchtop"/>
        <!-- memtest86+ in the installer USB's boot menu. memtest86+-bls ships
             the sdbootutil boot entry (/usr/lib/sdbootutil/entries.d), which
             disk.sh's `sdbootutil install` puts on the USB's ESP. Installed
             systems mask it (tik post module 13-tcbl-no-memtest). -->
        <package name="memtest86+"/>
        <package name="memtest86+-bls"/>
    </packages>
    <packages type="bootstrap">
        <!-- The rpm macro that keeps the launchers of terminal programs
             (htop, nvtop, atop, amdgpu_top's terminal interface) out of the
             image (%_netsharedpath, from tc-benchtop-settings). rpm reads
             macros when it starts, so the macro has to be in place before
             the image packages are installed. -->
        <package name="tc-benchtop-settings-rpm"/>
        <package name="coreutils"/>
        <package name="gawk"/>
        <package name="gzip"/>
        <package name="hostname"/>
        <package name="openssl"/>
        <package name="filesystem"/>
        <package name="glibc-locale-base"/>
        <package name="ca-certificates-mozilla"/>
    </packages>
</image>
